{
  "id": "flashcards-http-status-v1",
  "title": "HTTP 상태 코드",
  "subtitle": "서버가 무엇을 말하고 있는지 코드로 읽는다",
  "story": false,
  "quiz": "auto",
  "reverse": false,
  "autoplaySec": 6,
  "accent": "sky",
  "ratio": "8/5",
  "cards": [
    {
      "id": 1,
      "type": "basic",
      "category": "2xx 성공",
      "front": "200 은 무엇을 뜻하나?",
      "back": "요청이 성공했고 **본문에 결과가 실려 있다**.",
      "note": "GET 의 정상 응답이 대표적이다."
    },
    {
      "id": 2,
      "type": "basic",
      "category": "2xx 성공",
      "front": "201 은 언제 쓰나?",
      "back": "새 리소스를 **만들었을 때**. `Location` 헤더로 만들어진 주소를 알려준다.",
      "note": "POST 로 생성에 성공한 응답."
    },
    {
      "id": 3,
      "type": "basic",
      "category": "2xx 성공",
      "front": "204 는 무엇이 다른가?",
      "back": "성공했지만 **보낼 본문이 없다**.",
      "note": "DELETE 나 설정 저장처럼 돌려줄 표현이 없을 때."
    },
    {
      "id": 4,
      "type": "basic",
      "category": "3xx 이동",
      "front": "301 과 302 의 차이는?",
      "back": "301 은 **영구 이동**이라 캐시·검색엔진이 주소를 갱신하고, 302 는 **일시 이동**이라 원래 주소를 계속 쓴다.",
      "note": "영구 이동을 잘못 쓰면 브라우저가 오래 기억해 되돌리기 어렵다."
    },
    {
      "id": 5,
      "type": "basic",
      "category": "3xx 이동",
      "front": "304 는 무엇을 요구하나?",
      "back": "**캐시가 아직 유효하다** — 저장해 둔 것을 그대로 쓰라는 뜻이다.",
      "note": "조건부 요청(If-None-Match · If-Modified-Since)의 응답."
    },
    {
      "id": 6,
      "type": "basic",
      "category": "4xx 요청 문제",
      "front": "400 은 무엇을 가리키나?",
      "back": "요청 자체가 **문법적으로 잘못됐다** — 서버가 해석할 수 없다.",
      "note": "깨진 JSON, 필수 파라미터 누락."
    },
    {
      "id": 7,
      "type": "basic",
      "category": "4xx 요청 문제",
      "front": "401 과 403 의 차이는?",
      "back": "401 은 **누구인지 모른다**(인증 실패), 403 은 **누구인지 알지만 권한이 없다**.",
      "note": "401 에는 `WWW-Authenticate` 헤더가 따라온다."
    },
    {
      "id": 8,
      "type": "basic",
      "category": "4xx 요청 문제",
      "front": "409 는 어떤 상황인가?",
      "back": "리소스의 **현재 상태와 충돌**한다.",
      "note": "이미 있는 아이디로 가입, 동시 수정 충돌."
    },
    {
      "id": 9,
      "type": "basic",
      "category": "4xx 요청 문제",
      "front": "429 가 오면 무엇을 봐야 하나?",
      "back": "요청이 **너무 많다** — `Retry-After` 헤더가 알려주는 시간만큼 기다린다.",
      "note": "레이트 리밋. 재시도는 지수 백오프로."
    },
    {
      "id": 10,
      "type": "basic",
      "category": "5xx 서버 문제",
      "front": "500 은 무엇을 뜻하나?",
      "back": "서버 내부에서 **처리하다 실패**했다. 요청은 잘못되지 않았다.",
      "note": "클라이언트가 고칠 수 있는 것이 없다."
    },
    {
      "id": 11,
      "type": "basic",
      "category": "5xx 서버 문제",
      "front": "502 와 504 의 차이는?",
      "back": "502 는 상위 서버가 **잘못된 응답**을 줬고, 504 는 상위 서버가 **시간 안에 답하지 않았다**.",
      "note": "둘 다 게이트웨이·프록시가 내는 코드다."
    },
    {
      "id": 12,
      "type": "basic",
      "category": "5xx 서버 문제",
      "front": "503 은 언제 내야 하나?",
      "back": "서버가 **일시적으로 처리할 수 없을 때** — 과부하나 점검 중.",
      "note": "`Retry-After` 로 언제 다시 오면 되는지 알려주는 것이 예의다."
    }
  ]
}
